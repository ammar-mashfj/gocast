# ---------------------------------------------------------------------------
# api/.env — the NATIVE deployment delta.
#
# These are the keys whose value differs between the containerised stack and
# a native nginx/php-fpm host. Merge them into api/.env; everything not
# listed here (APP_KEY, mail, OAuth, Sentry, the Liquidsoap audio tuning
# block) is identical to the compose deployment.
#
# The reason this file exists at all: docker-compose.yml pins a dozen of
# these in its `environment:` block, which BEATS env_file. Natively there is
# no compose to pin them, so whatever is in api/.env is what the app uses —
# and the defaults in config/liquidsoap.php are the Docker values. Leaving
# them unset does not fail loudly; it renders `host = "icecast"` into every
# station's .liq and the station 401s or hangs on a name that does not
# resolve.
# ---------------------------------------------------------------------------

APP_ENV=production
APP_DEBUG=false
APP_URL=https://api.gocast.fm

# Next.js origin. Drives CORS and the links in transactional email.
FRONTEND_URL=https://gocast.fm
CORS_ALLOWED_ORIGINS="${FRONTEND_URL}"

# Shared parent domain, with the leading dot. If this stays null the auth
# cookie is scoped to api.gocast.fm alone and the Next.js server-side
# dashboard checks think every user is logged out — login appears to succeed
# and then the dashboard bounces them. See docs/deployment-auth-cookies.md.
SESSION_DOMAIN=.gocast.fm

# ---- Datastores: all on the host, all on loopback ----
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=gocast
DB_USERNAME=gocast
DB_PASSWORD=

# 127.0.0.1, not `redis` — there is no compose DNS here.
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=null
# phpredis (apt install php8.4-redis) rather than predis: it is a C
# extension instead of userland PHP, which matters because sessions, cache
# and the queue all go through it on every request. Switch to `predis` only
# if you cannot install the extension.
REDIS_CLIENT=phpredis

SESSION_DRIVER=redis
CACHE_STORE=redis
QUEUE_CONNECTION=redis

# ---- Docker access for LiquidsoapSupervisor ----
#
# The socket proxy from infra/native/docker-compose.native.yml, published on
# loopback. The alternative — adding the php-fpm user to the `docker` group
# — makes code execution in PHP equivalent to root on the host.
#
# NOT SUFFICIENT ON ITS OWN. `config:cache` stops Laravel loading this file,
# so the docker CLI never sees it. The value that actually reaches the
# subprocess comes from DOCKER_HOST_ADDR in infra/native/env/domains.env,
# which setup-native.sh renders into the php-fpm pool and the systemd units.
# Keep this line in step with that one; it is what a bare `php artisan` uses
# when the config cache is cleared.
DOCKER_HOST=tcp://127.0.0.1:2375

# ---- Addresses as seen FROM INSIDE a station container ----
#
# Not from where Laravel runs. Each station container gets
# `--add-host host.docker.internal:host-gateway`, so this is how it reaches
# services that now live on the host. The ports are the HOST ports, not the
# container ports the compose defaults assume.
LIQUIDSOAP_ICECAST_HOST=host.docker.internal
LIQUIDSOAP_ICECAST_PORT=8000
LIQUIDSOAP_API_URL=http://host.docker.internal:8081

# ---- Addresses as seen FROM LARAVEL ----
#
# Loopback: Laravel polls the Icecast admin API for listener counts.
ICECAST_INTERNAL_URL=http://127.0.0.1:8000

# `ip`, not `name`. Docker's embedded DNS does not exist for a host process,
# so Laravel cannot resolve `gocast-liquidsoap-{slug}` to poll a station's
# /status or open its telnet socket. `ip` makes it look the container's
# bridge address up with `docker inspect` first.
#
# Leaving this at the default `name` is the single most common native-mode
# mistake: stations start correctly and then every status poll times out,
# so the UI shows them stuck in `starting` forever.
LIQUIDSOAP_TELNET_RESOLVE=ip

# Public ingest endpoint handed to the studio. With this set, the browser
# connects to one TLS hostname and nginx routes by slug; with it EMPTY,
# Laravel falls back to handing out a raw `ws://<container-ip>:8090/{slug}`,
# which is plain-text and unreachable from anywhere but this host.
LIQUIDSOAP_INGEST_URL=wss://stream.gocast.fm/broadcast/{slug}

# ---- Secrets that compose used to supply ----
#
# Both of these were injected by docker-compose.yml's `environment:` block
# and are easy to miss when moving off it.
#
# Must match /etc/icecast2/icecast.xml or every station 401s on SOURCE
# connect — the station starts, then goes unhealthy about 45 seconds later.
ICECAST_SOURCE_PASSWORD=
ICECAST_ADMIN_USER=admin
ICECAST_ADMIN_PASSWORD=

# Shared secret on the /api/internal/* routes. Station containers send it as
# X-Internal-Key on harbor-auth, now-playing and station-event. If it is
# wrong, broadcasters cannot go live and nothing in the studio explains why.
INTERNAL_API_KEY=

# Hostnames + paths for the native (nginx/php-fpm/MySQL) deployment.
#
# Copy to infra/native/env/domains.env and edit. setup-native.sh and
# render-nginx.sh read this file to render the nginx vhosts and systemd
# units, so it is the single place the domain lives.

# Public app (Next.js).
APP_HOST=gocast.fm

# Laravel API.
API_HOST=api.gocast.fm

# Listener-facing Icecast.
ICECAST_HOST=icecast.gocast.fm

# Broadcaster ingest (WebSocket) + HLS playout.
STREAM_HOST=stream.gocast.fm

# Where the checkout lives on the box.
APP_ROOT=/srv/gocast/app

# Unix user everything PHP/Node runs as.
RUN_USER=gocast

# php-fpm version installed on the host. The pool socket name is derived
# from this, so it must match the package you installed.
PHP_VERSION=8.4

# Loopback port the Next.js standalone server binds to.
CLIENT_PORT=3000

# Loopback port native Icecast binds to. Must NOT be 8000 if anything else
# on the box wants it; the vhost proxies to it, nothing public hits it.
ICECAST_PORT=8000

# Loopback port the in-Docker station router listens on. Host nginx proxies
# /broadcast/{slug} here; the router resolves the per-station container.
ROUTER_PORT=8091

# Port the internal-only API vhost listens on. Reachable ONLY from the
# Docker bridges (see the ufw rules in setup-native.sh) — this is what
# station containers POST now-playing/harbor-auth to.
INTERNAL_API_PORT=8081

# Address of the Docker socket proxy, as the docker CLI should reach it.
#
# This is rendered into the php-fpm pool and the systemd units as a REAL
# process environment variable. Setting it only in api/.env is not enough —
# see the comment in php/gocast.pool.conf for why.
DOCKER_HOST_ADDR=tcp://127.0.0.1:2375

# Fixed subnet for gocast-network. Pinned so the firewall rules that let
# station containers reach host Icecast and the internal API vhost can be
# written as a stable CIDR instead of a bridge interface name that changes
# with the network's ID.
GOCAST_SUBNET=172.28.0.0/16

# The slice of that subnet Docker's own IPAM may allocate from.
#
# MUST NOT overlap the bottom of GOCAST_SUBNET. Station containers get a fixed
# address derived from their container_index, counting up from the base, so the
# bottom belongs to them and IPAM has to be kept out of it. Anything
# auto-assigned (the station router) lands in this slice instead.
#
# Keep LIQUIDSOAP_CONTAINER_SUBNET in api/.env equal to GOCAST_SUBNET above —
# that is the value Laravel computes station addresses from.
GOCAST_IPAM_RANGE=172.28.255.0/24

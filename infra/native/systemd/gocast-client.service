[Unit]
Description=GoCast web client (Next.js standalone)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__RUN_USER__
Group=__RUN_USER__

# The standalone bundle is self-contained but position-dependent: server.js
# expects ./public and ./.next/static to sit NEXT TO IT, which is why
# deploy-native.sh copies them in after every build. Running from anywhere
# else yields a site that renders HTML with no CSS and no images — a
# failure that looks like a broken build rather than a wrong path.
WorkingDirectory=__APP_ROOT__/client/.next/standalone

Environment=NODE_ENV=production
Environment=NEXT_TELEMETRY_DISABLED=1
Environment=PORT=__CLIENT_PORT__
# Loopback only. nginx is the only thing that should reach this; binding
# 0.0.0.0 would publish an untrusted-header HTTP server straight onto the
# internet alongside the properly configured vhost.
Environment=HOSTNAME=127.0.0.1
# Runtime secrets for the server side of the app — today only RENDER_API_KEY,
# which must equal the API's and lifts the public rate limit for SSR fetches.
# Optional (`-`): without it the site works, but a fast crawl of station pages
# gets 429s from the API and serves Googlebot error pages.
EnvironmentFile=-/etc/gocast/client.env

ExecStart=/usr/bin/node server.js

Restart=always
RestartSec=5

StandardOutput=journal
StandardError=journal
SyslogIdentifier=gocast-client

# Read-only except for one path. This unit was originally commented as
# writing nothing at all, which was wrong: Next's image optimizer writes
# optimized AVIF/WebP variants to .next/cache/images whenever it optimizes a
# remote image. Under ProtectSystem=strict that write fails, the optimization
# is redone on every single request, and Node reports the EROFS as a
# misleading ENOENT on the parent directory -- which sends you looking for a
# missing directory instead of a read-only one.
#
# The `-` prefix makes systemd tolerate the path not existing rather than
# refusing to start: deploy-native.sh creates it in build_client(), but
# setup-native.sh can legitimately run on a fresh host before any deploy has.
# A missing directory then degrades to the old behaviour (no cache) instead
# of taking the site down to protect a cache.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=-__APP_ROOT__/client/.next/standalone/.next/cache
ProtectHome=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target

# Laravel API as the phone sees it (laptop LAN IP on wlo1). Laravel must run
# with `php artisan serve --host=0.0.0.0` or the phone cannot reach it.
EXPO_PUBLIC_API_URL=http://192.168.1.10:8000/api

# Dev only. The API hands back the station container's Docker bridge IP as the
# ingest address, which a phone cannot route to. The station router proxies
# every station at 127.0.0.1:8091/broadcast/{slug}; scripts/ingest-proxy.mjs
# exposes that on the LAN. Leave empty in production to use the API's answer.
EXPO_PUBLIC_INGEST_URL=ws://192.168.1.10:18091/broadcast/{slug}

# Web app base URL, for the share link to the station player page.
EXPO_PUBLIC_APP_URL=http://192.168.1.10:3000

# The API's web OAuth client ID (api/.env GOOGLE_CLIENT_ID). Android's "Sign in
# with Google" sheet issues its ID token for this audience, and the API only
# accepts tokens issued for it. Public, not a secret. The sheet also needs an
# Android OAuth client for app.gocast.mobile + the signing SHA-1.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

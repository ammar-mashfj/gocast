# Real environment files anywhere in the tree — api/.env above all, which
# holds the DB password, both Icecast passwords and the internal API key.
# Only the committed templates are allowed through.
.env
.env.*
!.env.example

# OS / editor cruft
.DS_Store
.idea/
.vscode/
*.swp
*~

# Local logs, caches
*.log
.cache/

# Ad-hoc tarballs, backups
*.tar.gz
*.zip
*.sql
*.dump

# Native-deploy host config. These hold the real hostnames, paths and
# credentials for a specific box; the .example files beside them are the
# committed templates. Match on the directory, not on a leading dot — these
# are named `api.env` / `domains.env`, so the `.env*` rules above miss them.
infra/native/env/*.env
!infra/native/env/*.example

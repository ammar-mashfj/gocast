# Laravel API base URL
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# Public-facing app URL (used for OG tags, player links, Google OAuth redirect)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# NOTE: there is no ingest URL here. The publish address is issued per request
# by POST /api/auth/broadcast-token, because locally it points at the station
# container's bridge IP, which changes on every restart.

# Icecast stream URL for player audio playback (use https:// in production)
NEXT_PUBLIC_ICECAST_URL=http://localhost:8888

# Dev only. Host directory Liquidsoap writes HLS segments into, served by the
# /hls-proxy route so the HLS player can be exercised on a laptop — in
# production nginx serves this directory and nothing here is used. Point the
# API at it with LIQUIDSOAP_HLS_BASE_URL=http://localhost:3000/hls-proxy
LIQUIDSOAP_HLS_DIR=/var/gocast/hls

# --- Realtime dashboard updates (Ably, over the Pusher protocol) -------------
#
# Optional, and empty is the CLIENT-SIDE KILL SWITCH: with NEXT_PUBLIC_PUSHER_KEY
# unset, lib/echo.ts returns null, no socket is opened, and every dashboard
# polls exactly as it did before this feature existed.
#
# This is the switch that actually turns the feature off. The API's own
# (BROADCAST_CONNECTION=log) only stops the server sending: a browser with
# this key still connects, still subscribes, and slows its status poll to
# 30s trusting a socket that will never carry anything. Unset this in the
# same deploy whenever the server side is switched off.
#
# The KEY here is the public half of the Ably API key — the `APP_ID.KEY_ID`
# part, everything BEFORE the colon. The secret after the colon is a server
# credential and must never appear in a NEXT_PUBLIC_ variable; the browser
# proves who it is against /broadcasting/auth instead.
NEXT_PUBLIC_PUSHER_KEY=
NEXT_PUBLIC_PUSHER_HOST=main.pusher.ably.net
NEXT_PUBLIC_PUSHER_PORT=443

# Where Echo signs a private subscription.
#
# Spelled out rather than derived from NEXT_PUBLIC_API_URL, which already ends
# in /api — `/broadcasting/auth` is a SIBLING of that path, not a child. For
# LAN device testing this needs the machine's LAN IP for the same reason the
# API URL does.
NEXT_PUBLIC_BROADCAST_AUTH_URL=http://localhost:8000/broadcasting/auth

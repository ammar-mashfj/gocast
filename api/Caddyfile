# FrankenPHP Caddyfile — dev + direct-HTTPS (no Cloudflare) mode.
#
# Behaviour by $SERVER_NAME:
#   :80                 → plain HTTP, no certs (local dev)
#   api.gocast.fm       → Caddy auto-requests a Let's Encrypt cert, serves
#                         HTTP/2 and HTTP/3 (requires ports 80 + 443 open)
#
# If you're behind Cloudflare, swap this for `Caddyfile.cloudflare` — that
# config uses a Cloudflare Origin Certificate instead of Let's Encrypt.

{
	frankenphp
	order php_server before file_server
}

{$SERVER_NAME::80} {
	root * /app/public

	encode zstd br gzip

	# Laravel convention — /storage/<path> is the public disk. Served as
	# static files, not routed through PHP.
	@storage path /storage/*
	file_server @storage

	php_server
}

# ---------------------------------------------------------------------------
# Broadcaster ingest + HLS playout vhost (stream.gocast.fm).
#
# Why this block exists: browsers refuse to open a ws:// socket from an HTTPS
# page (mixed content), and Liquidsoap's harbor input speaks plain ws inside
# each station container. This terminates TLS once, here, and proxies the
# upgraded connection through to the right container — so no station container
# needs a certificate, a published port, or a DNS name of its own.
#
# Routing is by path: /broadcast/{slug} → gocast-liquidsoap-{slug}:8090.
# Containers are created and destroyed by LiquidsoapSupervisor as stations come
# and go, so the upstream is resolved from the path at request time rather than
# configured per station — Docker's embedded DNS on gocast-network turns the
# container name into an address, and a station that isn't running simply
# fails to connect, which is the correct answer.
#
# Unlike the WHIP setup this replaced, ALL broadcast traffic goes through this
# proxy: audio rides the same WebSocket as the handshake. There is no separate
# UDP media path, so this hostname no longer has to stay DNS-only in
# Cloudflare, and no ICE/STUN/TURN is involved anywhere.
#
# The cert must be publicly trusted, so this block always uses Caddy's
# automatic Let's Encrypt issuance — never the Cloudflare Origin Cert. HTTP-01
# validation works because the hostname resolves straight to this host and
# ports 80/443 are open.
#
# In dev the default `stream.localhost` is never routed to: Laravel hands the
# studio a ws:// address pointing straight at the container's bridge IP (see
# LiquidsoapSupervisor::ingestUrl), which Linux routes from the host without
# any proxy at all.
# ---------------------------------------------------------------------------
{$WHIP_SERVER_NAME:stream.localhost} {
	encode zstd br gzip

	# HLS playout — Liquidsoap writes /var/gocast/hls/{slug}/playlist.m3u8
	# plus segments; the api container has /var/gocast bind-mounted, so we
	# serve them straight off disk. Matched by extension so it can't collide
	# with the broadcast paths below.
	@hls path *.m3u8 *.ts *.aac *.mp4 *.m4s
	handle @hls {
		root * /var/gocast/hls
		# Players fetch the manifest from any origin, and a cached manifest
		# means a stalled stream — the segment window rolls every 2s.
		header Access-Control-Allow-Origin "*"
		header Cache-Control "no-cache"
		file_server
	}

	# Broadcaster ingest. The slug is constrained to the Str::slug() charset
	# so a crafted path can't be used to reach an arbitrary host on the
	# Docker network.
	@broadcast path_regexp bslug ^/broadcast/([a-z0-9][a-z0-9-]{0,62})$
	handle @broadcast {
		reverse_proxy gocast-liquidsoap-{re.bslug.1}:8090
	}

	handle {
		respond "Not found" 404
	}
}

# =============================================================================
# api/.env — the only application config file. Copy it and fill in the blanks:
#
#     cp api/.env.example api/.env
#     sed -i 's/gocast\.fm/YOURDOMAIN.com/g' api/.env
#     php artisan key:generate
#
# GoCast runs natively: nginx + php-fpm + MySQL + Redis + Icecast are host
# services. The only containers are one Liquidsoap per on-air station, plus
# the two support containers in infra/native/docker-compose.native.yml.
# See infra/native/README.md.
#
# Then fill in the five values marked FILL ME. Everything else is already
# correct for this deployment shape.
#
# The example domain throughout is gocast.fm, laid out as:
#     gocast.fm            → the public app (Next.js)
#     api.gocast.fm        → this API
#     icecast.gocast.fm    → listener audio
#     stream.gocast.fm     → broadcaster ingest + HLS
# The sed above rewrites all four at once.
# =============================================================================


# -----------------------------------------------------------------------------
# Application identity
# -----------------------------------------------------------------------------

# Display name. Appears in transactional email subjects and the From name.
APP_NAME=GoCast

# Runtime mode. `production` is what turns off the debug error page and lets
# Laravel trust its cached config. `local` here would expose stack traces.
APP_ENV=production

# 32-byte key encrypting cookies, sessions and anything through Crypt::.
# FILL ME → `php artisan key:generate` writes it in place.
# Changing it later logs every user out and makes existing encrypted rows
# unreadable, so generate once and keep it in your password manager.
APP_KEY=

# Never true on a public host: the debug page prints stack traces WITH the
# contents of this file, to anyone who can trigger an error.
APP_DEBUG=false

# Public base URL of this API, with scheme, no trailing slash. Used to build
# absolute links in email and the OAuth callback below.
# Example: https://api.gocast.fm
APP_URL=https://api.gocast.fm

# Interface language, and the fallback when a translation string is missing.
APP_LOCALE=en
APP_FALLBACK_LOCALE=en

# Locale the seeder/factories use for fake data. Irrelevant in production.
APP_FAKER_LOCALE=en_US

# Where `php artisan down` records that the site is in maintenance mode.
# `file` is correct for a single box; `cache` is for multi-server setups.
APP_MAINTENANCE_DRIVER=file

# `php artisan serve` runs PHP's built-in server, which handles ONE request at
# a time unless this is set. The dashboard fans out to four server-rendered API
# calls plus two client pollers, so a single worker serialises them and the
# Next.js 10s fetch budget expires before the page finishes.
#
# This ONLY takes effect with `php artisan serve --no-reload` — Laravel
# otherwise prints "Unable to respect the PHP_CLI_SERVER_WORKERS environment
# variable without the --no-reload flag" and silently falls back to one
# worker. Every dev entry point passes it (composer dev, the runbooks,
# playwright.config.ts). The cost of --no-reload is that the server no longer
# restarts itself when THIS file changes; PHP source is still re-read per
# request, so only .env and config edits need a manual restart.
PHP_CLI_SERVER_WORKERS=4

# Password hashing cost. Each +1 doubles the time. 12 is roughly 250ms per
# login on a modern vCPU — slow enough to resist offline cracking, fast
# enough not to be a login-page DoS.
BCRYPT_ROUNDS=12


# -----------------------------------------------------------------------------
# Logging  →  storage/logs/laravel.log
# -----------------------------------------------------------------------------

# `stack` means "write to every channel named in LOG_STACK below".
LOG_CHANNEL=stack

# `single` = one file that grows forever. `daily` = one file per day, kept
# 14 days, which is usually the better choice on a box you don't babysit.
LOG_STACK=single

# Where PHP deprecation notices go. `null` discards them; they are noise
# from vendor code you cannot fix.
LOG_DEPRECATIONS_CHANNEL=null

# Minimum severity written. `debug` in production logs every SQL query and
# every job payload, and will fill the disk on a busy day.
# Order: debug < info < notice < warning < error < critical < alert < emergency
LOG_LEVEL=warning


# -----------------------------------------------------------------------------
# Database — host MySQL, over loopback
# -----------------------------------------------------------------------------

DB_CONNECTION=mysql

# 127.0.0.1, not `localhost`: `localhost` makes the client use a unix socket,
# which is matched by a DIFFERENT MySQL grant. If you created the user as
# 'gocast'@'127.0.0.1' (as the runbook does), connecting to `localhost` fails
# with access-denied on a password you know is right.
DB_HOST=127.0.0.1
DB_PORT=3306

# Must match the CREATE DATABASE / CREATE USER you ran.
DB_DATABASE=gocast
DB_USERNAME=gocast

# FILL ME → the password from the CREATE USER statement.
DB_PASSWORD=


# -----------------------------------------------------------------------------
# Redis — host redis-server, over loopback
# -----------------------------------------------------------------------------

# 127.0.0.1: Redis is a host service (apt install redis-server).
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# The literal string `null` means no AUTH. Set a real password only if you
# also set `requirepass` in /etc/redis/redis.conf.
REDIS_PASSWORD=null

# `phpredis` is the C extension (apt install php8.4-redis); `predis` is a
# pure-PHP client. Sessions, cache and the queue all go through this on
# every request, so the extension is meaningfully faster.
REDIS_CLIENT=phpredis


# -----------------------------------------------------------------------------
# Drivers — what Laravel uses for each subsystem
# -----------------------------------------------------------------------------

# Where login sessions live. Redis survives a php-fpm reload; `file` would
# too, but Redis keeps deploys from leaving stale session files behind.
SESSION_DRIVER=redis

# Application cache, including the locks that stop the scheduler
# double-firing a job.
CACHE_STORE=redis

# Backend for queued jobs (uploads, track analysis, email). `sync` would run
# them inline in the web request, which would make an upload block for
# minutes.
QUEUE_CONNECTION=redis

# Laravel's websocket broadcasting. Unused by this app — `log` is a no-op
# that writes any broadcast attempt to the log instead of failing.
BROADCAST_CONNECTION=log

# Default storage disk. `local` = storage/app on this filesystem, which is
# what nginx serves via the public/storage symlink.
FILESYSTEM_DISK=local

# Vestigial: Laravel ships this key, and nothing here uses Memcached.
MEMCACHED_HOST=127.0.0.1


# -----------------------------------------------------------------------------
# Sessions and CORS
# -----------------------------------------------------------------------------

# Minutes of inactivity before a user is logged out. 120 = 2 hours.
SESSION_LIFETIME=120

# Encrypting the session payload on top of the signed HttpOnly cookie buys
# little and costs CPU on every request.
SESSION_ENCRYPT=false

# Cookie path. `/` means the whole site.
SESSION_PATH=/

# The SHARED PARENT domain, with a LEADING DOT. This is what lets the same
# auth cookie be sent to both gocast.fm and api.gocast.fm.
#
# Left at `null`, the cookie is scoped to api.gocast.fm alone: login appears
# to succeed, and then the Next.js server-side dashboard checks see no
# cookie and bounce the user straight back to the login page.
# Example: .gocast.fm
SESSION_DOMAIN=.gocast.fm

# Origin of the public app. Used for links in email and as the CORS origin.
# No trailing slash.
# Example: https://gocast.fm
FRONTEND_URL=https://gocast.fm

# Browser origins allowed to call this API. Comma-separate for more than
# one. Referencing FRONTEND_URL keeps the two from drifting apart.
CORS_ALLOWED_ORIGINS="${FRONTEND_URL}"


# -----------------------------------------------------------------------------
# Mail — optional. Blank RESEND_API_KEY disables outbound email.
# -----------------------------------------------------------------------------

# Transport. `resend` uses the API key below; `log` writes email to the log
# instead of sending, which is useful while testing.
MAIL_MAILER=resend

# From resend.com → API Keys. Without it, password resets and the "notify me
# when live" emails silently do not send.
RESEND_API_KEY=

# Envelope sender. The domain must be verified in Resend or mail is rejected.
# Example: hello@gocast.fm
MAIL_FROM_ADDRESS="hello@gocast.fm"

# Display name on outbound mail. Follows APP_NAME.
MAIL_FROM_NAME="${APP_NAME}"


# -----------------------------------------------------------------------------
# Google OAuth — optional. Blank disables the "Sign in with Google" button.
# -----------------------------------------------------------------------------

# Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client ID.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Must be registered byte-for-byte as an Authorised redirect URI in that
# same console screen, or Google returns redirect_uri_mismatch.
# Example: https://api.gocast.fm/api/auth/google/callback
GOOGLE_REDIRECT_URI="${APP_URL}/api/auth/google/callback"


# -----------------------------------------------------------------------------
# Off-host backups — optional. Read by backup.sh, not by the app.
# -----------------------------------------------------------------------------

# S3-compatible credentials for the nightly DB + uploads dump. Cloudflare R2,
# Backblaze B2 and MinIO all work. Leave blank to skip off-host backups —
# the pre-deploy dump in the runbook is local and works regardless.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=

# true for MinIO and other providers that need bucket-in-path URLs.
AWS_USE_PATH_STYLE_ENDPOINT=false


# =============================================================================
# From here down: the audio stack — Icecast, the station containers, and how
# Laravel and those containers address each other. This is the half that
# fails silently when it is wrong, so the comments are long on purpose.
# =============================================================================


# -----------------------------------------------------------------------------
# Internal API auth
# -----------------------------------------------------------------------------

# Shared secret on the /api/internal/* routes. Every station container sends
# it as an X-Internal-Key header when it authorises a broadcaster, pushes
# now-playing metadata, or asks for its next AutoDJ track.
#
# Wrong or blank: nobody can go live, and the studio does not explain why.
# FILL ME → openssl rand -hex 32
INTERNAL_API_KEY=


# -----------------------------------------------------------------------------
# Icecast
#
# These MUST match /etc/icecast2/icecast.xml — which the runbook renders FROM
# this file, so filling them here is enough. A mismatch means every station
# gets 401 on SOURCE connect: the station starts, then goes unhealthy about
# 45 seconds later.
# -----------------------------------------------------------------------------

# Password Liquidsoap uses to publish a station's stream INTO Icecast.
# FILL ME → openssl rand -hex 24
ICECAST_SOURCE_PASSWORD=

# Icecast admin login. Laravel uses it to poll listener counts once a minute.
ICECAST_ADMIN_USER=admin

# FILL ME → openssl rand -hex 24
ICECAST_ADMIN_PASSWORD=

# Only needed if another Icecast server relays from this one. Left blank, the
# runbook reuses the source password.
ICECAST_RELAY_PASSWORD=

# How LARAVEL reaches Icecast, to read listener counts. Loopback, because
# Laravel now runs on the same box. Not the public URL.
# Example: http://127.0.0.1:8000
ICECAST_INTERNAL_URL=http://127.0.0.1:8000


# -----------------------------------------------------------------------------
# Docker access
# -----------------------------------------------------------------------------

# The socket proxy from infra/native/docker-compose.native.yml, on loopback.
# Laravel spawns one Liquidsoap container per on-air station through it.
#
# The alternative — adding the php-fpm user to the `docker` group — makes
# code execution in PHP equivalent to root on the host.
#
# NOT SUFFICIENT ON ITS OWN. `config:cache` stops Laravel loading this file
# at all, so the docker CLI never sees this line. The value that actually
# reaches the subprocess is set in the php-fpm pool (env[DOCKER_HOST]) and in
# the gocast-queue / gocast-scheduler systemd units. Keep all three in step;
# this line is what a bare `php artisan` uses once the config cache is clear.
DOCKER_HOST=tcp://127.0.0.1:2375


# -----------------------------------------------------------------------------
# How a STATION CONTAINER sees the world
#
# Not how Laravel sees it. These three strings are rendered into every
# station's .liq file, and are resolved from INSIDE a Liquidsoap container.
# Each container is started with `--add-host host.docker.internal:host-gateway`,
# so that name is how it reaches Icecast and this API, both of which run on
# the host. Note that host-gateway resolves to the DEFAULT bridge gateway
# (172.17.0.1) even though stations sit on gocast-network, so both services
# must listen on all interfaces — the firewall rules in setup-native.sh are
# what keep them off the public internet.
# -----------------------------------------------------------------------------

# Where the station publishes its audio.
LIQUIDSOAP_ICECAST_HOST=host.docker.internal
LIQUIDSOAP_ICECAST_PORT=8000

# Where the station calls back to this API — the internal-only nginx vhost on
# port 8081, reachable from Docker but firewalled off from the internet.
# Example: http://host.docker.internal:8081
LIQUIDSOAP_API_URL=http://host.docker.internal:8081


# -----------------------------------------------------------------------------
# How LARAVEL addresses a station container
# -----------------------------------------------------------------------------

# The subnet gocast-network is created with. Each station's container address
# is this base plus its container_index plus 2, so this MUST equal the subnet
# in infra/native/docker-compose.native.yml, which is what actually creates
# the network. A mismatch hands every station an address outside its own
# network and nothing starts.
LIQUIDSOAP_CONTAINER_SUBNET=172.28.0.0/16

# `ip` or `name`. Laravel polls each station's /status endpoint and opens a
# telnet socket to it for skip/reload commands — so it has to turn
# `gocast-liquidsoap-{slug}` into an address.
#
#   ip   — compute it from the station's container_index and the subnet
#          above. Required for a host process, which has no access to Docker's
#          DNS. This is the default in config/liquidsoap.php and the value you
#          want; being arithmetic, a status poll costs no daemon round trip.
#   name — resolve via Docker's embedded DNS. Only works for a process that
#          is itself on gocast-network. Nothing in this deployment is.
#
# Set to `name` and stations start correctly, then sit in `starting` forever
# because every poll times out.
LIQUIDSOAP_TELNET_RESOLVE=ip


# -----------------------------------------------------------------------------
# Broadcaster ingest
# -----------------------------------------------------------------------------

# The WebSocket URL handed to the studio page when someone goes live.
# `{slug}` is substituted per station. nginx routes /broadcast/{slug} to the
# right container via the station-router.
#
# Left EMPTY, Laravel falls back to handing out a raw
# ws://<container-ip>:8090/{slug} — plain text, and unreachable from anywhere
# but this host, so nobody can broadcast.
# Example: wss://stream.gocast.fm/broadcast/{slug}
LIQUIDSOAP_INGEST_URL=wss://stream.gocast.fm/broadcast/{slug}

# Port INSIDE each station container where broadcasters connect. Harbor
# speaks two protocols on it: the studio's WebSocket, and the classic Icecast
# source protocol (BUTT, Mixxx). Never published to the host.
LIQUIDSOAP_HARBOR_INPUT_PORT=8090

# Seconds harbor waits on a stalled broadcaster before declaring them gone.
# This is the reconnect window: until it expires, the mount is still held and
# the studio's retry is refused. Liquidsoap's own default of 30 is too long.
LIQUIDSOAP_HARBOR_INPUT_TIMEOUT=10.0


# =============================================================================
# Audio behaviour. The defaults below are sane — tune later, not now.
# The long-form reasoning for every value is in api/config/liquidsoap.php.
# =============================================================================


# --- Where per-station files live on the host --------------------------------

# Generated .liq scripts, one per station. Laravel writes; each container
# bind-mounts its own file read-only.
LIQUIDSOAP_LIQ_DIR=/var/gocast/liq

# Uploaded AutoDJ tracks, one subdirectory per station.
LIQUIDSOAP_PLAYLISTS_DIR=/var/gocast/playlists

# HLS segments written BY the container and served by nginx.
LIQUIDSOAP_HLS_DIR=/var/gocast/hls

# Per-station AutoDJ storage cap, in bytes. 3221225472 = 3 GiB.
#
# This is GLOBAL, not per-plan: free stations get the same ceiling. That is
# affordable only because Free has no AutoDJ and therefore little reason to
# upload — watch disk usage until the cap becomes per-plan.
LIQUIDSOAP_STATION_STORAGE_BYTES=3221225472


# --- Per-station container resource caps -------------------------------------

# CPU cores per station. 0.5 = half a core. Empty string disables the cap.
LIQUIDSOAP_CONTAINER_CPUS=0.5

# Memory per station. Do NOT go below ~448m: Liquidsoap 2.4 with the ffmpeg
# HLS encoder is SIGKILLed during startup at 256m, and the container dies
# with an EMPTY log — which reads as a config error rather than an OOM.
LIQUIDSOAP_CONTAINER_MEMORY=512m


# --- Station status endpoint -------------------------------------------------

# Port inside each container serving /status and /healthz over HTTP. Laravel
# reads what is playing and how far in from here.
LIQUIDSOAP_HARBOR_PORT=8080

# Seconds Laravel waits for that endpoint before giving up.
LIQUIDSOAP_HARBOR_TIMEOUT=1.5

# Seconds a fetched status is cached. Short, because it carries a playback
# position — but non-zero so a list page does not hit every container.
LIQUIDSOAP_STATUS_TTL=2


# --- Dead-air guard on the live input ----------------------------------------

# A broadcaster whose mic dies keeps their socket open, so without this the
# live source stays "available" and listeners hear silence while AutoDJ waits
# behind it. Seconds of silence before the live source is dropped; 0 disables.
LIQUIDSOAP_BLANK_MAX_SECONDS=15

# Level below which audio counts as silence, in dBFS.
LIQUIDSOAP_BLANK_THRESHOLD_DB=-40


# --- AutoDJ rotation ---------------------------------------------------------

# Laravel serves the rotation one track at a time over
# /api/internal/next-track; there is no playlist file. (There was, and
# reloading it restarted the list at track 1 — so uploading a song sent
# listeners back to the beginning of the rotation.)

# Seconds before a station re-asks after "nothing to play". Liquidsoap's own
# default is 0.1s — ten requests a second, forever, per empty station.
LIQUIDSOAP_AUTODJ_RETRY_DELAY=10


# --- AutoDJ crossfade (track changes only, never the live input) -------------

# Off because it has not yet been seen working here: every attempt wedged
# AutoDJ into looping one buffered frame (heard as a stuck-PC buzz) with
# nothing logged. Two real defects have since been fixed; whether that was
# enough is untested. Turn on deliberately, with 2+ tracks, and watch.
LIQUIDSOAP_CROSSFADE_ENABLED=false

# Seconds of overlap between tracks.
LIQUIDSOAP_CROSSFADE_DURATION=5

# Seconds of fade within that overlap. MUST be strictly shorter than the
# duration above, or the fades never complete and you hear an abrupt jump.
LIQUIDSOAP_CROSSFADE_FADE=3

# Loudness thresholds (dB) deciding whether to overlap or hard-cut. Used only
# when crossfade is enabled; hard-cutting two loud tracks avoids clipping.
LIQUIDSOAP_CROSSFADE_HIGH_DB=-15
LIQUIDSOAP_CROSSFADE_MEDIUM_DB=-32
LIQUIDSOAP_CROSSFADE_MARGIN_DB=4


# --- Peak limiter ------------------------------------------------------------

# Overflow protection before the encoders, in dBFS. Not loudness shaping.
LIQUIDSOAP_LIMITER_THRESHOLD_DB=-1.0

# true puts the limiter at the very bottom of the graph, so a hot live
# broadcaster is guarded too. false limits only the AutoDJ arm.
LIQUIDSOAP_LIMITER_INCLUDE_LIVE=true


# --- Broadcaster metadata ----------------------------------------------------

# Shown when a broadcaster sends no track title at all — the studio page
# included. Without it, the last AutoDJ title just stays put for the whole
# show, i.e. the stream asserting something false.
LIQUIDSOAP_LIVE_BROADCAST_TEXT="Live Broadcast"

# Character set for titles arriving from source clients. Clients disagree and
# there is no negotiation; a wrong guess shows mojibake, not lost audio.
LIQUIDSOAP_METADATA_CHARSET=UTF-8


# --- Track analysis ----------------------------------------------------------

# Measure every upload once, in a queued job: loudness and where the audio
# really starts and stops. Applied as playback annotations — the uploaded
# file is never modified. Backfill with `php artisan tracks:analyze`.
LIQUIDSOAP_ANALYSIS_ENABLED=true

# Path to a local ffmpeg. Empty borrows the station image's, one throwaway
# container per track — so no second ffmpeg has to be installed on the host.
LIQUIDSOAP_ANALYSIS_FFMPEG=

# Seconds before one track's analysis is abandoned.
LIQUIDSOAP_ANALYSIS_TIMEOUT=120


# --- Loudness levelling ------------------------------------------------------

# false makes every stored measurement inert fleet-wide, without touching a
# row — the rollback if levelling ever sounds wrong.
LIQUIDSOAP_APPLY_AMPLIFY=true

# Target loudness in LUFS. -14 is the streaming convention (Spotify, YouTube
# and Apple all land within a dB or two), so the library sounds right next to
# whatever the listener played before.
LIQUIDSOAP_LOUDNESS_TARGET=-14.0

# True-peak ceiling in dB, matching the limiter threshold on purpose.
LIQUIDSOAP_LOUDNESS_CEILING=-1.0

# Maximum dB of BOOST. Stops a near-silent field recording being amplified
# until its noise floor hisses. Attenuation is deliberately uncapped, since
# turning something down cannot introduce noise.
LIQUIDSOAP_LOUDNESS_MAX_GAIN=12.0


# --- Silence trimming --------------------------------------------------------

# Level counting as silence at the head/tail of a track, in dBFS. Generous,
# because trimming into real audio is far worse than leaving a gap.
LIQUIDSOAP_ANALYSIS_SILENCE_DB=-50

# Seconds of silence before trimming starts.
LIQUIDSOAP_ANALYSIS_SILENCE_SECONDS=0.25

# Discard a measurement that would leave a track shorter than this many
# seconds — a mis-detection would otherwise cut a song short on air while
# the file itself looks fine.
LIQUIDSOAP_CUE_MIN_PLAYABLE=5


# --- Memory ------------------------------------------------------------------

# OCaml GC space_overhead: percent of live heap tolerated before collecting
# harder. Lower holds less memory and costs more CPU. 80 is balanced; 0 runs
# the stock GC, which is the rollback if a station starts burning CPU.
LIQUIDSOAP_GC_SPACE_OVERHEAD=80


# --- Auto-stop ---------------------------------------------------------------

# Seconds a station may produce NO AUDIO, with nothing attached that could
# start producing some, before `stations:sweep` takes it off air. 0 disables
# stopping entirely. Needs gocast-scheduler running.
#
# This is NOT an idle timeout. Listener count plays no part in it: an AutoDJ
# rotation playing to an empty room is a paid feature working as sold. Nor is
# a connected-but-muted broadcaster on this clock — the container reports the
# socket separately from the audio, so a quiet mic keeps the station up.
#
# Effective time to stop is one to two windows: the sweep needs one pass to
# start the clock and another to act on it.
LIQUIDSOAP_SILENT_STOP_SECONDS=60

# Output level (0.0-1.0) at or below which a station counts as producing
# nothing. Not simply 0.0 — an encoder noise floor can sit just above it.
# ~0.0001 is about -80 dBFS.
LIQUIDSOAP_SILENCE_RMS_THRESHOLD=0.0001

# Averaging window for the output-level meter the container reports. Also its
# update interval: it reads 0.0 until the first window completes. Keep it short
# — smoothing inter-track gaps is the auto-stop window's job, not this one's.
LIQUIDSOAP_RMS_WINDOW_SECONDS=2


# --- HLS playout ------------------------------------------------------------

# Public base URL listeners fetch HLS from — the stream vhost in front of
# /var/gocast/hls. No trailing slash. Leave EMPTY to disable HLS playback
# entirely: the API then reports a null hls_url and the player falls back to
# the Icecast mount.
#
# On a dev laptop nothing serves that directory, so point this at the Next dev
# server's dev-only route instead:
#     LIQUIDSOAP_HLS_BASE_URL=http://localhost:3000/hls-proxy
LIQUIDSOAP_HLS_BASE_URL=https://stream.gocast.fm

# Name of the single HLS rendition. This one value becomes both the encoder
# label in the .liq script and the media-playlist filename in the URL the
# player is given: /{slug}/{variant}.m3u8
#
# It must stay shared. Liquidsoap also writes playlist.m3u8 beside it, but that
# is a MASTER playlist, and players drop the query string when resolving a
# master's variant URI — so a master URL can never carry a per-listener token
# to the segment requests that follow. Anything identifying a listener from
# manifest requests has to address the media playlist directly.
#
# Changing this renames a public URL. Players holding the old one 404 until
# they reload.
LIQUIDSOAP_HLS_VARIANT=aac

# --- Listener analytics ------------------------------------------------------

# Transport recorded when the player does not name one: hls or icecast.
#
# The player normally sends its own — only it knows whether it used the HLS URL
# it was given or fell back to the Icecast mount. This is the fallback for a
# client too old to say.
#
# It decides whether a session is ADDED to the live count. Icecast listeners
# hold a socket and are already inside the number the admin poll returns, so
# their sessions are recorded (country, device, duration) but never counted
# twice. HLS listeners are invisible to that poll, so theirs are summed with it.
ANALYTICS_PLAYER_TRANSPORT=hls

# How often the player checks in, and how long a session counts as live after
# its last check-in. The window must stay comfortably above the interval: drop
# it below and every listener expires between their own beats, and the live
# count reads zero while people are listening.
ANALYTICS_BEAT_INTERVAL=15
ANALYTICS_LIVE_WINDOW=45

# How long after its last check-in a session is closed and its duration
# written. Longer than the live window on purpose — falling out of the count is
# reversible, closing the session is not, so a listener who reconnects inside a
# minute keeps one session instead of splitting into two.
ANALYTICS_IDLE_CLOSE=60

# Hard ceiling on one session. A tab left open on a desk beats for as long as
# the machine is awake; without this, one listener contributes days of
# listening time to a station's totals.
ANALYTICS_MAX_SESSION_HOURS=12

# Minimum duration before a session counts as a real listen. The IAB
# podcast-measurement threshold, adopted so these numbers mean the same thing
# as everyone else's. Shorter sessions are still stored — they are how you spot
# a stream everybody bounces off — they just don't inflate the headline count.
ANALYTICS_MIN_LISTEN_SECONDS=60

# How long raw per-listener rows are kept. The hourly and daily rollups are
# permanent; this table is not. Pruning is what turns listener_sessions from a
# table that grows forever into one that holds a fixed size. 0 disables it.
ANALYTICS_RETENTION_DAYS=90

# Optional GeoLite2 country database for resolving a listener's country from
# their IP, once, when their session opens. Needs the geoip2/geoip2 package as
# well; without either, country is simply null and nothing else changes.
# Behind Cloudflare the CF-IPCountry header is used first and this is unused.
ANALYTICS_GEOIP_DATABASE=/var/gocast/system/GeoLite2-Country.mmdb
ANALYTICS_COUNTRY_HEADER=CF-IPCountry


# --- Vestigial ---------------------------------------------------------------

# Laravel ships this for its Vite dev server. The client here is Next.js, so
# nothing reads it. Harmless.
VITE_APP_NAME="${APP_NAME}"


# --- Sentry ------------------------------------------------------------------

# Error reporting. Leave the DSN empty to disable the SDK entirely.
SENTRY_LARAVEL_DSN=
SENTRY_SEND_DEFAULT_PII=false

# Performance tracing, OFF by default and deliberately so.
#
# The SDK's default transport ships each transaction over the network before
# the request finishes, so a sample rate of 1.0 puts a full round-trip to
# Sentry's ingest host on the critical path of EVERY request. Measured on a dev
# laptop against two identical servers: ~11ms per api call at 0, ~0.7s at 1.0.
# The dashboard makes four to six calls per page, and under a single-worker
# server they queue behind each other's flush -- so the page cost is a multiple
# of that, not a single 0.7s. Same shape in production, just a shorter hop.
#
# Sample, don't disable, once you need it: 0.05-0.1 in production, and set it
# to 1.0 locally only while you are reading traces, then put it back.
SENTRY_TRACES_SAMPLE_RATE=0

APP_NAME=GoCast
APP_ENV=local
APP_KEY=
# Must be false in production - exposes stack traces and env vars
APP_DEBUG=true
APP_URL=http://localhost
ADMIN_DOMAIN=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=api
DB_USERNAME=root
DB_PASSWORD=

# Must be true in production
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
# In production with separate app/API subdomains, use the shared parent
# domain (for example: .gocast.fm) so the HttpOnly auth cookie reaches both.
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mail — production uses Resend API. Set MAIL_MAILER=log only in dev.
MAIL_MAILER=resend
RESEND_API_KEY=
MAIL_FROM_ADDRESS="hello@gocast.fm"
MAIL_FROM_NAME="${APP_NAME}"

# Where unauthenticated routes (verification email links) point users back into the app.
FRONTEND_URL=http://localhost:3000

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Client app URL - used for Google OAuth redirects and CORS
# Update to production domain (e.g. https://gocast.fm)
FRONTEND_URL=http://localhost:3000

# Google OAuth - get from https://console.cloud.google.com
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must match the redirect URI registered in Google Cloud Console
GOOGLE_REDIRECT_URI="${APP_URL}/api/auth/google/callback"

# CORS - comma-separated origins allowed to call the API
# In production, set to your domain only (e.g. https://gocast.fm)
CORS_ALLOWED_ORIGINS="${FRONTEND_URL}"

# Shared secret for internal server-to-server calls (MediaMTX lifecycle
# webhooks, Liquidsoap now-playing pushes). Required.
INTERNAL_API_KEY=

# Icecast source/admin credentials baked into per-station .liq files and
# used by Liquidsoap to publish to the Icecast mounts. The admin pair is also
# what `stations:sync-listeners` authenticates with when polling listener counts.
ICECAST_SOURCE_PASSWORD=
ICECAST_ADMIN_USER=admin
ICECAST_ADMIN_PASSWORD=

# In-network Icecast base URL for the admin API (listener-count polling).
# Not the public listener URL — that's NEXT_PUBLIC_ICECAST_URL on the client.
ICECAST_INTERNAL_URL=http://icecast:8000

# Per-station Liquidsoap host paths (created by infra/setup-host.sh).
LIQUIDSOAP_LIQ_DIR=/var/gocast/liq
LIQUIDSOAP_PLAYLISTS_DIR=/var/gocast/playlists
LIQUIDSOAP_HLS_DIR=/var/gocast/hls

# Per-station AutoDJ storage cap in bytes (default 100 MiB).
LIQUIDSOAP_STATION_STORAGE_BYTES=104857600

# Per-station Liquidsoap container resource caps (empty disables the cap).
LIQUIDSOAP_CONTAINER_CPUS=0.5
LIQUIDSOAP_CONTAINER_MEMORY=256m

VITE_APP_NAME="${APP_NAME}"

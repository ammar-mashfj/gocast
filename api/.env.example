APP_NAME=GoCast
APP_ENV=local
APP_KEY=
# Must be false in production - exposes stack traces and env vars
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=api
DB_USERNAME=root
DB_PASSWORD=

# Must be true in production
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
# In production with separate app/API subdomains, use the shared parent
# domain (for example: .gocast.fm) so the HttpOnly auth cookie reaches both.
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mail — production uses Resend API. Set MAIL_MAILER=log only in dev.
MAIL_MAILER=resend
RESEND_API_KEY=
MAIL_FROM_ADDRESS="hello@gocast.fm"
MAIL_FROM_NAME="${APP_NAME}"

# Where unauthenticated routes (verification email links) point users back into the app.
FRONTEND_URL=http://localhost:3000

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Client app URL - used for Google OAuth redirects and CORS
# Update to production domain (e.g. https://gocast.fm)
FRONTEND_URL=http://localhost:3000

# Google OAuth - get from https://console.cloud.google.com
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must match the redirect URI registered in Google Cloud Console
GOOGLE_REDIRECT_URI="${APP_URL}/api/auth/google/callback"

# CORS - comma-separated origins allowed to call the API
# In production, set to your domain only (e.g. https://gocast.fm)
CORS_ALLOWED_ORIGINS="${FRONTEND_URL}"

# Shared secret for internal server-to-server calls (harbor auth callback,
# Liquidsoap lifecycle events and now-playing pushes). Required.
INTERNAL_API_KEY=

# Broadcaster ingest. Harbor listens on this port INSIDE each station
# container; nothing publishes it to the host.
LIQUIDSOAP_HARBOR_INPUT_PORT=8090

# Seconds harbor waits on a stalled source before declaring it gone. This is
# the reconnect window: a broadcaster whose connection dies without a clean
# close (sleeping laptop, wifi handover) still holds the mount until this
# expires, and every reconnect the studio attempts is refused until it does.
# Liquidsoap's own default is 30, which is a long time to be locked out of
# your own mount. The studio retries for two minutes regardless, so this
# tunes how FAST a reconnect lands, not whether it can.
LIQUIDSOAP_HARBOR_INPUT_TIMEOUT=10.0

# Public WebSocket base the studio publishes to, with {slug} substituted, e.g.
#   LIQUIDSOAP_INGEST_URL=wss://stream.gocast.fm/broadcast/{slug}
# Leave unset in local hybrid dev: Laravel then addresses the station container
# directly on the Docker bridge, which the host can route to on Linux without
# publishing a port or running a proxy.
LIQUIDSOAP_INGEST_URL=

# Icecast source/admin credentials baked into per-station .liq files and
# used by Liquidsoap to publish to the Icecast mounts. The admin pair is also
# what `stations:sync-listeners` authenticates with when polling listener counts.
ICECAST_SOURCE_PASSWORD=
ICECAST_ADMIN_USER=admin
ICECAST_ADMIN_PASSWORD=

# In-network Icecast base URL for the admin API (listener-count polling).
# Not the public listener URL — that's NEXT_PUBLIC_ICECAST_URL on the client.
ICECAST_INTERNAL_URL=http://icecast:8000

# Per-station Liquidsoap host paths (created by infra/setup-host.sh).
LIQUIDSOAP_LIQ_DIR=/var/gocast/liq
LIQUIDSOAP_PLAYLISTS_DIR=/var/gocast/playlists
LIQUIDSOAP_HLS_DIR=/var/gocast/hls

# --- Where a STATION CONTAINER finds Icecast and this API ---
# These describe the network from inside a Liquidsoap container, not from
# wherever Laravel is running. Leave them unset for the all-Docker setup:
# the config defaults (icecast:8000, http://api) are the compose service
# names, and docker-compose.yml pins them explicitly anyway.
#
# Set them ONLY when running Laravel natively on the host with just the
# audio services in Docker. The host is reachable from a station container
# as host.docker.internal, and the ports become the published host ports:
#
#   LIQUIDSOAP_ICECAST_HOST=host.docker.internal
#   LIQUIDSOAP_ICECAST_PORT=8888
#   LIQUIDSOAP_API_URL=http://host.docker.internal:8000
#   LIQUIDSOAP_TELNET_RESOLVE=ip
#   ICECAST_INTERNAL_URL=http://localhost:8888
#
# LIQUIDSOAP_TELNET_RESOLVE switches how Laravel addresses a station
# container for skip/reload commands: `name` uses Docker DNS (only works
# from inside the network), `ip` looks the address up with docker inspect
# (required from a host process). See config/liquidsoap.php.

# Per-station AutoDJ storage cap in bytes (default 100 MiB).
LIQUIDSOAP_STATION_STORAGE_BYTES=104857600

# Per-station Liquidsoap container resource caps (empty disables the cap).
# Do NOT drop the memory cap below ~448m: Liquidsoap 2.4 with the ffmpeg
# HLS encoder is SIGKILLed during startup at 256m, and the container dies
# with an empty log, which looks like a config error rather than an OOM.
LIQUIDSOAP_CONTAINER_CPUS=0.5
LIQUIDSOAP_CONTAINER_MEMORY=512m

# --- Station control surface ---
# Each station container serves /status and /healthz on this port over
# gocast-network (harbor HTTP). Laravel pulls live audio state from there:
# what is playing, how far in, what is queued next. Requires the same
# INTERNAL_API_KEY the now-playing push uses.
LIQUIDSOAP_HARBOR_PORT=8080
LIQUIDSOAP_HARBOR_TIMEOUT=1.5
# Seconds a pulled status is cached. Keep short — it carries a playback
# position — but non-zero so list pages don't hit every container.
LIQUIDSOAP_STATUS_TTL=2

# --- Dead-air guard on the live input ---
# A broadcaster whose mic dies keeps their socket open, so without this the
# live source stays "available" and listeners hear silence while AutoDJ
# waits behind it. Seconds of silence below the threshold before the live
# source is marked unavailable; 0 disables the guard entirely.
LIQUIDSOAP_BLANK_MAX_SECONDS=15
LIQUIDSOAP_BLANK_THRESHOLD_DB=-40

# --- AutoDJ crossfade (AutoDJ track changes only, never the live input) ---
# Off by default, but only because it has not been seen working here yet.
#
# Every attempt so far wedged AutoDJ: output degenerated to a single buffered
# frame looping forever (a static harmonic spectrum, heard as a stuck-PC buzz),
# elapsed() climbed past the track length, remaining() froze, decoder
# End_of_file stopped firing, and nothing was logged. It reproduced on 2.4.0 AND
# on 2.4.5, so it is NOT upstream savonet#4851 as first assumed.
#
# Two real defects on our side have since been fixed, neither yet proven to be
# the cause: the fade length equalled the cross window (book 6.4 requires it to
# be strictly shorter), and /status called autodj.length()/remaining_files() on
# the very source cross() fast-forwards, which the book allows only one operator
# to use. Both are corrected; whether that is enough is untested.
#
# To try it: confirm the station is healthy with this false, then set it true,
# relaunch, and watch that End_of_file keeps firing once per track and
# elapsed+remaining sums to the track duration. Use 2+ tracks.
# How the AutoDJ rotation gets its next track.
#
# true  — Laravel answers one track at a time over /api/internal/next-track
#         (request.dynamic). The default, and how AzuraCast/LibreTime work.
# false — the legacy playlist.m3u source.
#
# Why the default changed: `playlist.reload`, which the file mode must send
# after every track add/remove/reorder, restarts the list at index 0 (measured
# on 2.4.5). Uploading a song sent listeners back to song one. Dynamic mode has
# no list in the container, so there is nothing to reset and nothing to reload.
#
# Rolling back is this flag plus `stations:relaunch` — the m3u is still written
# in both modes, so nothing else has to change. Note the API becomes
# load-bearing for rotation audio: if it is unreachable a station falls through
# to its silence bed (and says so in its container log) until it recovers.
LIQUIDSOAP_AUTODJ_DYNAMIC=true
# Seconds before a station re-asks after "nothing to play" or a failure.
# Liquidsoap's own default is 0.1s, i.e. ten requests a second forever for
# every station with an empty library.
LIQUIDSOAP_AUTODJ_RETRY_DELAY=10

LIQUIDSOAP_CROSSFADE_ENABLED=false
# The cross WINDOW and the FADE length are different things and must not be
# equal: the book (6.4) requires the duration to be strictly longer than the
# fades, or "the fades will not be complete and you will hear abrupt changes in
# the volume". These were one shared value until now. Defaults are the book's.
LIQUIDSOAP_CROSSFADE_DURATION=5
LIQUIDSOAP_CROSSFADE_FADE=3
# Thresholds for the cross.smart port, used only if the switch above is ever
# turned back on. Mirrors AzuraCast: compare the loudness of the outgoing and
# incoming track and hard cut rather than overlap when both are loud, which is
# what keeps a master limited to 0.0 dBFS from clipping mid-transition.
LIQUIDSOAP_CROSSFADE_HIGH_DB=-15
LIQUIDSOAP_CROSSFADE_MEDIUM_DB=-32
LIQUIDSOAP_CROSSFADE_MARGIN_DB=4

# --- Peak limiter ---
# Overflow protection on the way to the encoders, not loudness shaping: the
# gain is static above the threshold, so it cannot breathe the way normalize()
# does. The threshold is a dBFS ceiling.
#
# INCLUDE_LIVE=true puts it at the bottom of the graph, past the live/AutoDJ
# fallback and past the watermark, so everything a listener hears is guarded.
# It used to wrap the AutoDJ arm alone, which protected the one arm whose
# levels we already control and left a hot broadcaster to hit the encoder with
# no headroom at all. Set false to restore that placement exactly.
#
# Safe on the live path: the rule against operators there is about
# TRACK-BOUNDARY operators (cross() re-triggering forever on an endless
# stream), and limit() has no track logic. Verified — 42s of a mark-free
# carrier produced no source leak and no latency catch-up.
LIQUIDSOAP_LIMITER_THRESHOLD_DB=-1.0
LIQUIDSOAP_LIMITER_INCLUDE_LIVE=true

# --- Broadcaster metadata ---
# Harbor accepts the titles a DJ's own client sends in band (BUTT, Mixxx). They
# used to be parsed and discarded, so a DJ running a playlist showed listeners
# whichever AutoDJ track was up when they connected, for the whole show.
#
# LIVE_BROADCAST_TEXT covers the client that sends nothing at all, the studio
# page included — without it the stale AutoDJ title simply stays put, i.e. the
# stream asserting something false rather than saying nothing.
#
# METADATA_CHARSET decodes what the client sends. Source clients disagree and
# there is no negotiation; the failure mode for a wrong guess is mojibake in a
# title, not lost audio. Length capping happens in NowPlayingController.
LIQUIDSOAP_LIVE_BROADCAST_TEXT="Live Broadcast"
LIQUIDSOAP_METADATA_CHARSET=UTF-8

# --- Track analysis ---
# Every upload is measured once, in a queued job: how loud it is (EBU R128
# integrated loudness plus true peak) and where the audio really starts and
# stops. Those become liq_amplify / liq_cue_in / liq_cue_out annotations, so
# the corrections happen at playback and the uploaded file is never modified.
#
# It fixes the two things a station's own library does to it: a mastered single
# next to a podcast export 20 dB below it (a listener reaching for the volume
# between every track), and a rip carrying three seconds of leading silence (a
# gap that reads as the stream having died).
#
# ANALYSIS_FFMPEG is the path to a local ffmpeg. Left empty, the analyser
# borrows the station image's — one throwaway container per track, the same
# build that decodes the file on air, and no second ffmpeg in the API image.
#
# Backfill an existing library with `php artisan tracks:analyze`.
LIQUIDSOAP_ANALYSIS_ENABLED=true
LIQUIDSOAP_ANALYSIS_FFMPEG=
LIQUIDSOAP_ANALYSIS_TIMEOUT=120

# Loudness leveling. -14 LUFS is the streaming convention (Spotify, YouTube and
# Apple all land within a dB or two), so a library leveled here sounds right
# next to whatever the listener played before us. The ceiling matches the
# limiter threshold on purpose — the limiter is for what we failed to predict,
# not the plan. MAX_GAIN stops a near-silent field recording being amplified
# until its noise floor hisses; attenuation is deliberately uncapped, since
# turning something down cannot introduce noise.
#
# Only raw measurements are stored, so retuning the target relevels the whole
# library at each station's next track boundary — no re-analysis, no restart.
# APPLY_AMPLIFY=false drops the amplify operator from the audio graph and makes
# every liq_amplify annotation inert, fleet-wide, without touching a row.
LIQUIDSOAP_APPLY_AMPLIFY=true
LIQUIDSOAP_LOUDNESS_TARGET=-14.0
LIQUIDSOAP_LOUDNESS_CEILING=-1.0
LIQUIDSOAP_LOUDNESS_MAX_GAIN=12.0

# Silence trimming. The threshold is generous because a quiet fade-in is not
# silence and trimming into real audio is far worse than leaving a gap. Only
# the head and tail are cut; silence in the middle is either intentional or a
# gap between movements. CUE_MIN_PLAYABLE discards a measurement that would
# truncate a track below this many seconds — a mis-detected threshold would
# otherwise cut a song short on air while the file itself looks fine.
LIQUIDSOAP_ANALYSIS_SILENCE_DB=-50
LIQUIDSOAP_ANALYSIS_SILENCE_SECONDS=0.25
LIQUIDSOAP_CUE_MIN_PLAYABLE=5

# --- Memory ---
# OCaml GC space_overhead: the percentage of live heap the collector tolerates
# before working harder. The default 120 lets a process hold roughly twice its
# live data; lower collects more often and holds less, which is the right trade
# on a box running one container per station. AzuraCast's presets are 20 (less
# memory), 80 (balanced), 140 (less CPU). 0 omits the block and runs the stock
# GC — the rollback if a station starts burning CPU.
LIQUIDSOAP_GC_SPACE_OVERHEAD=80

# --- Idle auto-stop ---
# Fallback window for `stations:reap-idle` when a plan has no
# idle_stop_hours of its own. Hours a station may stay on air with no
# listeners and no broadcaster; 0 disables the reaper.
LIQUIDSOAP_IDLE_STOP_HOURS=6

# --- Silent-station auto-stop ---
# Seconds a station with NO AutoDJ rotation may stay on air after its
# broadcaster disconnects, before the container is stopped. 0 disables it.
#
# Much shorter than the window above, and a different situation: a station
# with a rotation still has audio to play between broadcasts, while one with
# an empty library has nothing but the silence bed — so every second it stays
# up is a container, an Icecast source slot and continuous HLS writes spent
# transmitting nothing.
#
# Only a station that HAS had a broadcaster is on this clock (measured from
# the end of its last stream session). One that was started and never
# broadcast to is left to LIQUIDSOAP_IDLE_STOP_HOURS, so pressing the power
# button and going live a few minutes later cannot switch the station off
# underneath the owner.
#
# Keep this comfortably inside the studio's two-minute reconnect budget: a
# broadcaster who gets back on air within the window keeps their container.
LIQUIDSOAP_SILENT_STOP_SECONDS=60

VITE_APP_NAME="${APP_NAME}"
